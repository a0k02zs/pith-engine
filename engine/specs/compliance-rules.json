      "rules": [
        {
          "id": "UK-PRIVACY-URL",
          "channels": [
            "email"
          ],
          "severity": "block",
          "message": "Privacy notice URL required."
        },
        {
          "id": "UK-COOKIE",
          "channels": [
            "web_page",
            "landing_page"
          ],
          "severity": "block",
          "message": "Cookie consent before any tracking, including A/B test, heatmap and session-recording tools."
        },
        {
          "id": "UK-LIA",
          "channels": [
            "email",
            "linkedin_message"
          ],
          "when": "basis == legitimate_interest",
          "severity": "warn",
          "message": "Legitimate interest assessment must be on file for cold B2B email."
        },
        {
          "id": "UK-VAT-PRICE",
          "channels": [
            "web_page",
            "landing_page",
            "paid_ad"
          ],
          "when": "segment == b2c and price_mentions not empty",
          "severity": "block",
          "message": "UK B2C prices must include VAT."
        },
        {
          "id": "UK-HFSS",
          "channels": [
            "paid_ad",
            "social_post",
            "influencer_post",
            "video",
            "web_page"
          ],
          "when": "paid.product_category == less_healthy_food",
          "severity": "block",
          "message": "UK: paid online ads for less healthy food and drink are banned from 5 January 2026."
        },
        {
          "id": "UK-DRIP-PRICE",
          "channels": [
            "web_page",
            "landing_page",
            "paid_ad"
          ],
          "severity": "block",
          "message": "No drip pricing: mandatory fees must be in the headline price (DMCC Act 2024)."
        }
      ],
      "send_window": {
        "from": "08:00",
        "to": "21:00",
        "days": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
        ]
      }
    },
