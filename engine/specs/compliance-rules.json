{
  "rules_version": "2026-10-21.8",
  "$comment": "Planning summary taken from the Pith M Automation Plan market sections. Not legal advice. A local lawyer confirms each market before launch. Rule ids are stable; services may cite them.",
  "global": [
    {
      "id": "G-CONSENT-RECORD",
      "channels": [
        "email",
        "sms",
        "whatsapp",
        "push",
        "phone_call"
      ],
      "purpose": "marketing",
      "severity": "block",
      "check": "every recipient comes from /audiences/resolve and has an eligible consent for its own country",
      "message": "Recipient has no consent record valid for their country."
    },
    {
      "id": "G-SUPPRESSED",
      "channels": [
        "*"
      ],
      "severity": "block",
      "check": "contact.suppressed == false",
      "message": "Contact is suppressed (bounce, complaint, erasure, DNC)."
    },
    {
      "id": "G-CLAIM-APPROVED",
      "channels": [
        "*"
      ],
      "severity": "block",
      "check": "every claim, price, health, finance or legal statement matches an approved claim for each market",
      "message": "New or unapproved claim. Open a claim approval."
    },
    {
      "id": "G-BANNED-TERM",
      "channels": [
        "*"
      ],
      "severity": "block",
      "check": "no banned term for the client or market",
      "message": "Banned term found."
    },
    {
      "id": "G-UNSUB",
      "channels": [
        "email"
      ],
      "purpose": "marketing",
      "severity": "block",
      "check": "working unsubscribe link and List-Unsubscribe header",
      "message": "Email needs an unsubscribe link and header."
    },
    {
      "id": "G-SENDER-ID",
      "channels": [
        "email",
        "sms",
        "whatsapp"
      ],
      "severity": "block",
      "check": "sender legal name present; sender identity matches brand.sender_identity",
      "message": "Sender identity missing."
    },
    {
      "id": "G-PAID-DISCLOSURE",
      "channels": [
        "influencer_post",
        "social_post",
        "video",
        "affiliate_link"
      ],
      "when": "paid.is_paid_partnership",
      "severity": "block",
      "check": "market disclosure label present (see market.disclosure_labels)",
      "message": "Paid content needs the ad disclosure label for this market."
    },
    {
      "id": "G-RIGHTS",
      "channels": [
        "*"
      ],
      "when": "media.people not empty or music or stock used",
      "severity": "block",
      "check": "active rights_grants for each person, scope and market; licence refs present",
      "message": "Missing likeness, voice, music or stock rights."
    },
    {
      "id": "G-NO-FAKE-REVIEWS",
      "channels": [
        "review_request",
        "social_post",
        "web_page"
      ],
      "severity": "block",
      "check": "no incentive tied to positive reviews, no review gating, no fabricated reviews",
      "message": "Fake, bought or gated reviews are not allowed in any market."
    },
    {
      "id": "G-SENSITIVE-TOPIC",
      "channels": [
        "*"
      ],
      "severity": "warn",
      "check": "content touches brand.sensitive_topics, religion, politics",
      "message": "Sensitive topic. A person must review."
    },
    {
      "id": "G-SEND-WINDOW",
      "channels": [
        "sms",
        "whatsapp",
        "phone_call",
        "push"
      ],
      "severity": "block",
      "check": "send_at inside market.send_window in recipient local time",
      "message": "Outside allowed local send hours."
    },
    {
      "id": "G-AI-IMAGE-LABEL",
      "channels": [
        "web_page",
        "landing_page",
        "paid_ad",
        "social_post",
        "video"
      ],
      "when": "media.ai_generated",
      "severity": "warn",
      "message": "AI-generated media: add the platform AI label. Required (block) in EU markets by EU-AI-LABEL."
    },
    {
      "id": "G-LIST-UPLOAD",
      "channels": [
        "paid_ad"
      ],
      "when": "paid.targeting.custom_list_audience_id",
      "severity": "block",
      "check": "audience built by /audiences/resolve with channel=paid_ad; each contact basis in eligible_bases.paid_ad; gpc_opt_out excluded",
      "message": "Customer list upload needs an eligible basis for ad matching."
    },
    {
      "id": "G-SENSITIVE-TARGETING",
      "channels": [
        "paid_ad"
      ],
      "when": "paid.targeting.uses_sensitive_categories",
      "severity": "block",
      "message": "No targeting on sensitive categories (legal ban in the EU under the DSA; Pith policy elsewhere)."
    },
    {
      "id": "G-MINOR-TARGETING",
      "channels": [
        "paid_ad",
        "social_post",
        "influencer_post"
      ],
      "when": "paid.targeting.min_age < 18",
      "severity": "block",
      "message": "No targeted ads to minors."
    },
    {
      "id": "G-POLITICAL",
      "channels": [
        "*"
      ],
      "when": "paid.political",
      "severity": "block",
      "message": "Political ads are out of scope for Pith M."
    },
    {
      "id": "G-RESTRICTED-PRODUCT",
      "channels": [
        "paid_ad",
        "social_post",
        "influencer_post",
        "video"
      ],
      "when": "paid.product_category not in [general]",
      "severity": "warn",
      "message": "Restricted product: check platform and market rules."
    },
    {
      "id": "G-DO-NOT-CONTACT",
      "channels": [
        "press_pitch",
        "email",
        "linkedin_message"
      ],
      "when": "recipient is a party",
      "severity": "block",
      "check": "party.do_not_contact == false",
      "message": "This person opted out of contact from Pith (all clients)."
    },
    {
      "id": "G-DARK-PATTERN",
      "channels": [
        "web_page",
        "landing_page",
        "email"
      ],
      "severity": "block",
      "message": "No dark patterns: fake countdowns, fake scarcity, pre-ticked consent, confirmshaming, hidden fees."
    }
  ],
  "markets": {
