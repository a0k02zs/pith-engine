{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "email/winner@1",
  "type": "object",
  "properties": {
    "winner_variant": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "enum": [
        "ctr",
        "revenue_per_recipient"
      ]
    },
    "lift": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision": {
      "enum": [
        "winner",
        "keep_control"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "winner_variant",
    "metric",
    "lift",
    "confidence",
    "decision",
    "note"
  ],
  "additionalProperties": false
}
