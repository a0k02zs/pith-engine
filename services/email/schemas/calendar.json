{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "email/calendar@1",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "sends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "send_id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "local_time": {
            "type": "string",
            "minLength": 1,
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^after_iftar$"
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
            },
            "minItems": 1
          },
          "segment": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "kpi": {
            "type": "string",
            "minLength": 1
          },
          "offer_id": {
            "type": "string",
            "minLength": 1
          },
          "content_ref": {
            "type": "string",
            "minLength": 1
          },
          "test_variable": {
            "enum": [
              "subject",
              "offer",
              "cta",
              "send_time",
              "layout",
              "body",
              "none"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "send_id",
          "date",
          "local_time",
          "markets",
          "segment",
          "goal",
          "kpi",
          "test_variable"
        ],
        "additionalProperties": false
      }
    },
    "flow_work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flow_code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(B2C|B2B|SHARED|OUT)-\\d{2}$"
          },
          "action": {
            "enum": [
              "build",
              "fix",
              "retire"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "flow_code",
          "action",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "month",
    "sends",
    "flow_work",
    "risks",
    "blockers"
  ],
  "additionalProperties": false
}
