{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "email/learning@1",
  "type": "object",
  "properties": {
    "learnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "segment": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "lift": {
                "type": "number"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "date": {
                "type": "string",
                "minLength": 1,
                "format": "date"
              }
            },
            "required": [
              "n",
              "metric",
              "lift",
              "confidence",
              "date"
            ],
            "additionalProperties": false
          },
          "replaces_learning_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text",
          "market",
          "segment",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    }
  },
  "required": [
    "learnings"
  ],
  "additionalProperties": false
}
