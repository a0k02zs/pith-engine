{
  "id": "pr.angle_plan",
  "version": 1,
  "service": "pr",
  "description": "WF-2. Monthly story-angle plan from client news, data, trends and the search team's citation targets.",
  "trigger": {
    "cron": "0 7 25 * *",
    "manual": true
  },
  "steps": [
    {
      "id": "signals",
      "type": "tool",
      "name": "Trends, competitor coverage, news calendar",
      "tool": {
        "name": "pr",
        "action": "trends.search",
        "risk": "read"
      }
    },
    {
      "id": "citation_targets",
      "type": "tool",
      "name": "Search (5) link and citation targets stored as learnings from svc.search/roadmap.approved",
      "tool": {
        "name": "engine",
        "action": "brain.search",
        "risk": "read"
      }
    },
    {
      "id": "angles",
      "type": "agent",
      "name": "8 to 12 angle cards (T3), scored",
      "needs": [
        "signals",
        "citation_targets"
      ],
      "agent": {
        "prompt_ref": "pr/angle_strategist@1",
        "output_schema": "pr/angle_cards@1"
      }
    },
    {
      "id": "check",
      "type": "check",
      "needs": [
        "angles"
      ],
      "check": {
        "kinds": [
          "brand",
          "compliance",
          "fact"
        ],
        "min_brand_score": 80
      }
    },
    {
      "id": "approve_plan",
      "type": "gate",
      "name": "PR lead picks angles",
      "needs": [
        "check"
      ],
      "gate": {
        "approval_kind": "plan",
        "required_roles": [
          "pr_lead"
        ],
        "sla_hours": 48,
        "on_reject": "fail",
        "on_changes": "angles"
      }
    },
    {
      "id": "client_plan",
      "type": "gate",
      "name": "Client approves angles and spokespeople",
      "needs": [
        "approve_plan"
      ],
      "gate": {
        "approval_kind": "plan",
        "required_roles": [
          "client_approver"
        ],
        "sla_hours": 48,
        "on_reject": "fail",
        "on_changes": "angles"
      }
    },
    {
      "id": "has_claims",
      "type": "branch",
      "needs": [
        "client_plan"
      ],
      "branch": {
        "cases": [
          {
            "if": "size(steps.angles.output.new_claim_ids) > 0",
            "goto": "new_claims"
          }
        ],
        "else": "campaigns"
      }
    },
    {
      "id": "new_claims",
      "type": "gate",
      "name": "New claims in approved angles",
      "needs": [
        "has_claims"
      ],
      "gate": {
        "approval_kind": "claim",
        "required_roles": [
          "client_legal",
          "client_approver"
        ],
        "sla_hours": 72,
        "on_reject": "fail",
        "on_changes": "angles"
      }
    },
    {
      "id": "campaigns",
      "type": "subflow",
      "needs": [
        "has_claims"
      ],
      "subflow": {
        "workflow_id": "pr.pitch_campaign",
        "per": "angle"
      }
    },
    {
      "id": "done",
      "type": "emit",
      "needs": [
        "campaigns"
      ],
      "emit": {
        "event": "svc.pr/angle_plan.approved"
      }
    }
  ]
}
