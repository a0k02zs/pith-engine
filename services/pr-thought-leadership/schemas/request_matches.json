{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr/request_matches@1",
  "title": "Journalist request matches (WF-4)",
  "type": "object",
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "feed": {
            "type": "string",
            "minLength": 1
          },
          "party_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "spokesperson_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "request_id",
          "feed",
          "party_id",
          "spokesperson_id",
          "score",
          "reason",
          "deadline_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "request_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "matches",
    "dropped"
  ],
  "additionalProperties": false
}
