{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr/monthly_report@1",
  "title": "Monthly report (T12)",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(pr\\.)?[a-z0-9_]+$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "previous": {
            "type": [
              "number",
              "null"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "top_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 3
    },
    "worked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 3
    },
    "did_not_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 3
    },
    "next_month": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": [
    "month",
    "headline",
    "kpis",
    "top_coverage",
    "worked",
    "did_not_work",
    "next_month"
  ],
  "additionalProperties": false
}
