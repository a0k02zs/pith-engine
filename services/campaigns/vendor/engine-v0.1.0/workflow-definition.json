{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pith.marketing/contracts/v0/workflow-definition.json",
  "title": "A service pipeline as data",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "<service>.<name>, e.g. email.monthly_calendar"
    },
    "version": {
      "type": "integer"
    },
    "service": {
      "type": "string",
      "description": "service code from enums.json services"
    },
    "description": {
      "type": "string"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string"
        },
        "cron": {
          "type": "string"
        },
        "manual": {
          "type": "boolean"
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "JSON Schema of run input"
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "type": {
            "enum": [
              "agent",
              "tool",
              "check",
              "gate",
              "wait",
              "branch",
              "emit",
              "subflow",
              "task"
            ]
          },
          "name": {
            "type": "string"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agent": {
            "type": "object",
            "properties": {
              "prompt_ref": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reads_brain": {
                "type": "boolean",
                "default": true
              },
              "output_schema": {
                "type": "string"
              }
            }
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "risk": {
                "enum": [
                  "read",
                  "write_internal",
                  "write_external",
                  "remove",
                  "spend",
                  "send",
                  "sign",
                  "pay"
                ]
              }
            }
          },
          "check": {
            "type": "object",
            "properties": {
              "kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "brand",
                    "compliance",
                    "spam",
                    "links",
                    "accessibility",
                    "fact"
                  ]
                }
              },
              "min_brand_score": {
                "type": "number"
              }
            }
          },
          "gate": {
            "type": "object",
            "properties": {
              "approval_kind": {
                "type": "string"
              },
              "required_roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_count": {
                "type": "integer"
              },
              "sla_hours": {
                "type": "number"
              },
              "skip_if": {
                "type": "string",
                "description": "expression; see specs/approval-inbox.md \u00a74"
              },
              "on_reject": {
                "enum": [
                  "fail",
                  "goto"
                ]
              },
              "on_changes": {
                "type": "string",
                "description": "step id to return to"
              }
            }
          },
          "wait": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              },
              "match": {
                "type": "string"
              },
              "timeout": {
                "type": "string"
              }
            }
          },
          "branch": {
            "type": "object",
            "properties": {
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "if": {
                      "type": "string"
                    },
                    "goto": {
                      "type": "string"
                    }
                  }
                }
              },
              "else": {
                "type": "string"
              }
            }
          },
          "emit": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              }
            }
          },
          "subflow": {
            "type": "object",
            "properties": {
              "workflow_id": {
                "type": "string"
              },
              "per": {
                "type": "string",
                "description": "fan out per market, per channel, ..."
              }
            }
          },
          "retry": {
            "type": "object",
            "properties": {
              "attempts": {
                "type": "integer",
                "default": 3
              },
              "backoff": {
                "type": "string",
                "default": "exponential"
              }
            }
          },
          "timeout": {
            "type": "string"
          },
          "task": {
            "type": "object",
            "description": "A human task that is not an approval (record an interview, film a shoot, ship a product)",
            "properties": {
              "title": {
                "type": "string"
              },
              "assignee_roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "due_hours": {
                "type": "number"
              },
              "done_output_schema": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "version",
    "service",
    "steps"
  ],
  "additionalProperties": false
}