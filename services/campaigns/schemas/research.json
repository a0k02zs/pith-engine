{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaigns/research@1",
  "type": "object",
  "properties": {
    "past_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "channel",
          "market",
          "finding",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "offers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ad_themes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "creators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "ad_themes",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "market_context": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "channel_trends": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "key_dates",
          "channel_trends",
          "rules"
        ],
        "additionalProperties": false
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "insight": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "dated": {
            "type": "boolean"
          }
        },
        "required": [
          "insight",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "past_results",
    "competitors",
    "market_context",
    "insights",
    "missing"
  ],
  "additionalProperties": false
}