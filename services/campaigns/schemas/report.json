{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaigns/report@1",
  "type": "object",
  "properties": {
    "report_markdown": {
      "type": "string",
      "minLength": 1
    },
    "lessons": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule",
          "evidence",
          "market"
        ],
        "additionalProperties": false
      }
    },
    "decisions_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "report_markdown",
    "lessons",
    "decisions_needed"
  ],
  "additionalProperties": false
}