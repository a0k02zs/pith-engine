{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaigns/intake@1",
  "type": "object",
  "properties": {
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "type",
          "detail",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "suggested_type": {
      "enum": [
        "product_launch",
        "seasonal_push",
        "demand_generation",
        "event_led",
        "brand_awareness",
        "market_entry"
      ]
    },
    "suggested_flight_weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "client_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 5
    },
    "ready_for_g1": {
      "type": "boolean"
    }
  },
  "required": [
    "missing",
    "risks",
    "suggested_type",
    "suggested_flight_weeks",
    "client_questions",
    "ready_for_g1"
  ],
  "additionalProperties": false
}