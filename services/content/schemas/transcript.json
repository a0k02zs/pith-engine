{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content/transcript@1",
  "type": "object",
  "properties": {
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "expert": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "recording_consent": {
      "const": true
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "brief_id",
    "expert",
    "recorded_at",
    "recording_consent",
    "text"
  ],
  "additionalProperties": false
}