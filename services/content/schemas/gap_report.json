{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content/gap_report@1",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "sales_call",
              "support_ticket",
              "search_data",
              "ai_prompt",
              "competitor"
            ]
          },
          "persona": {
            "type": "string",
            "minLength": 1
          },
          "funnel_stage": {
            "enum": [
              "awareness",
              "consideration",
              "decision",
              "retention"
            ]
          },
          "current_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "source",
          "persona",
          "funnel_stage",
          "current_url",
          "coverage",
          "value",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}