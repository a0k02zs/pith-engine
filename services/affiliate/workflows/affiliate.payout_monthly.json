{
  "id": "affiliate.payout_monthly",
  "version": 1,
  "service": "affiliate",
  "description": "Conversion validation and monthly payout. An agent never releases money (G2).",
  "trigger": {
    "cron": "0 6 1 * *"
  },
  "inputs": {
    "type": "object",
    "required": [
      "client_id",
      "period"
    ],
    "properties": {
      "client_id": {
        "type": "string"
      },
      "period": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$"
      }
    }
  },
  "concurrency": {
    "key": "event.data.client_id",
    "limit": 1
  },
  "steps": [
    {
      "id": "ingest",
      "type": "tool",
      "name": "Pull conversions and order status",
      "needs": [],
      "tool": {
        "name": "affiliate",
        "action": "conversions.list",
        "risk": "read"
      },
      "retry": {
        "attempts": 3,
        "backoff": "exponential"
      }
    },
    {
      "id": "fraud",
      "type": "agent",
      "name": "Approve, hold or reverse each conversion",
      "needs": [
        "ingest"
      ],
      "agent": {
        "prompt_ref": "affiliate/fraud_monitor@1",
        "model": "claude-haiku-5-5",
        "output_schema": "affiliate/fraud_results@1"
      }
    },
    {
      "id": "any_holds",
      "type": "branch",
      "name": "Holds or reversals over GBP 500?",
      "needs": [
        "fraud"
      ],
      "branch": {
        "cases": [
          {
            "if": "any(steps.fraud.output.results, .decision == 'hold' || (.decision == 'reverse' && .amount_gbp > 500))",
            "goto": "review_holds"
          }
        ],
        "else": "payout_file"
      }
    },
    {
      "id": "review_holds",
      "type": "gate",
      "name": "Decide held conversions and large reversals",
      "needs": [
        "any_holds"
      ],
      "gate": {
        "approval_kind": "escalation",
        "required_roles": [
          "account_lead"
        ],
        "required_count": 1,
        "sla_hours": 72,
        "on_reject": "fail"
      }
    },
    {
      "id": "payout_file",
      "type": "agent",
      "name": "Build payout file (T8)",
      "needs": [
        "any_holds"
      ],
      "agent": {
        "prompt_ref": "affiliate/payout_clerk@1",
        "model": "claude-haiku-5-5",
        "output_schema": "affiliate/payout_file@1"
      }
    },
    {
      "id": "within_cap",
      "type": "branch",
      "name": "Payout inside budget cap?",
      "needs": [
        "payout_file"
      ],
      "branch": {
        "cases": [
          {
            "if": "steps.payout_file.output.within_cap == false",
            "goto": "over_cap"
          }
        ],
        "else": "approve_payout"
      }
    },
    {
      "id": "over_cap",
      "type": "emit",
      "name": "Payout over cap: stop and escalate",
      "needs": [
        "within_cap"
      ],
      "emit": {
        "event": "svc.affiliate/payout.over_cap"
      }
    },
    {
      "id": "approve_payout",
      "type": "gate",
      "name": "Approve monthly payout (detail: lines[{party_id, amount, currency, period, proof_url}], totals_by_currency)",
      "needs": [
        "within_cap"
      ],
      "gate": {
        "approval_kind": "payout",
        "required_roles": [
          "account_lead",
          "client_finance"
        ],
        "required_count": 2,
        "sla_hours": 72,
        "on_reject": "fail"
      }
    },
    {
      "id": "pay",
      "type": "tool",
      "name": "Release payments",
      "needs": [
        "approve_payout"
      ],
      "tool": {
        "name": "payout",
        "action": "payout.execute",
        "risk": "pay"
      }
    },
    {
      "id": "statements",
      "type": "agent",
      "name": "Write partner statements (T8)",
      "needs": [
        "pay"
      ],
      "agent": {
        "prompt_ref": "affiliate/payout_clerk@1",
        "model": "claude-haiku-5-5",
        "output_schema": "affiliate/payout_file@1"
      }
    },
    {
      "id": "statement_check",
      "type": "check",
      "name": "Compliance and link check on statements",
      "needs": [
        "statements"
      ],
      "check": {
        "kinds": [
          "compliance",
          "links"
        ]
      }
    },
    {
      "id": "send_statements",
      "type": "tool",
      "name": "Send statements",
      "needs": [
        "statement_check"
      ],
      "tool": {
        "name": "esp",
        "action": "message.send",
        "risk": "send"
      }
    },
    {
      "id": "emit_paid",
      "type": "emit",
      "name": "Record payouts (type payout_sent)",
      "needs": [
        "pay"
      ],
      "emit": {
        "event": "engine/outbound.recorded"
      }
    }
  ]
}
