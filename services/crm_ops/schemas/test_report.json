{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm_ops/test_report@1",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "pass": {
            "type": "boolean"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "none"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "expected",
          "actual",
          "pass",
          "severity",
          "evidence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 40
    },
    "blockers": {
      "type": "integer",
      "minimum": 0
    },
    "majors": {
      "type": "integer",
      "minimum": 0
    },
    "consent_failures": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "cases",
    "blockers",
    "majors",
    "consent_failures"
  ],
  "additionalProperties": false
}
