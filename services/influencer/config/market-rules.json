  "global": {
    "label_window_chars": 125,
    "weak_tags": ["#sp", "#spon", "#collab", "#partner", "#ambassador", "thanks to"],
    "video_label_required": true,
    "gift_needs_label": true,
    "min_real_follower_pct": 75,
    "min_audience_in_market_pct": { "b2c": 30, "b2b": 20 },
    "brand_safety_lookback_months": 24,
    "competitor_lookback_days": 90,
    "minor_banned_categories": ["alcohol", "gambling", "finance", "weight_loss"],
    "payout_terms_business_days": { "target": 7, "max": 15 },
    "outreach_follow_up_days": [3, 7],
    "max_review_rounds": 2
  },
