{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "messaging/precheck@1",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "warn"
      ]
    },
    "checks": {
      "type": "array",
