        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "brand_name",
              "optout",
              "category",
              "claims",
              "sensitive_data",
              "length",
              "encoding",
              "links",
              "language",
              "culture",
              "window",
              "consent",
              "frequency",
              "platform"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "warn"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "result",
          "reason"
        ],
        "additionalProperties": false
      },
