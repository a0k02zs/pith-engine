{
  "_about": "Pith M push template library, ported from the service design (draft 1, 21 Oct 2026). Title max 40 and body max 120 characters.",
  "templates": [
    {
      "id": "P-ORDER-SHIP",
      "flow": "F04",
      "category": "utility",
      "title": "Your order is on its way",
      "body": "Order {{order_id}} ships today. Tap to track it.",
      "deep_link": "app://orders/{{order_id}}"
    },
    {
      "id": "P-BROWSE",
      "flow": "F03",
      "category": "marketing",
      "title": "Still thinking about it?",
      "body": "{{product}} is waiting for you.",
      "deep_link": "app://product/{{sku}}"
    },
    {
      "id": "P-PRICE-DROP",
      "flow": "F09",
      "category": "marketing",
      "title": "Price drop on a saved item",
      "body": "{{product}} is now {{price}}.",
      "deep_link": "app://product/{{sku}}"
    },
    {
      "id": "P-BACK-STOCK",
      "flow": "F09",
      "category": "marketing",
      "title": "Back in stock",
      "body": "{{product}} is back. Sizes go fast.",
      "deep_link": "app://product/{{sku}}"
    },
    {
      "id": "P-CART",
      "flow": "F02",
      "category": "marketing",
      "title": "Your cart is saved",
      "body": "{{item_count}} items are waiting. Check out in 1 tap.",
      "deep_link": "app://cart"
    },
    {
      "id": "P-STREAK",
      "flow": "Engagement",
      "category": "marketing",
      "title": "Keep your streak going",
      "body": "You are on day {{n}}. 2 minutes keeps it alive.",
      "deep_link": "app://home"
    },
    {
      "id": "P-TRIAL-D3",
      "flow": "B2B trial",
      "category": "marketing",
      "title": "Set up {{feature}} in 2 minutes",
      "body": "Teams that do this on day 3 get value 2x faster.",
      "deep_link": "app://setup/{{feature}}"
    },
    {
      "id": "P-RENEW",
      "flow": "F12",
      "category": "utility",
      "title": "Your plan renews soon",
      "body": "{{plan}} renews on {{date}}. Review it here.",
      "deep_link": "app://billing"
    }
  ]
}
