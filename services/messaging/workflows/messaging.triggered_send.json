{
  "id": "messaging.triggered_send",
  "version": 1,
  "service": "messaging",
  "description": "Send 1 flow message (F01 to F13) to 1 contact after a client event, with consent, send window, caps and the channel waterfall.",
  "trigger": {
    "event": "engine/client.event"
  },
  "concurrency": {
    "key": "event.data.client_id + ':' + event.data.contact_id",
    "limit": 1
  },
  "steps": [
    {
      "id": "find_flow",
      "type": "tool",
      "name": "Find the active flow for this event (service code: flows.match)",
      "tool": {
        "name": "messaging",
        "action": "flows.match",
        "risk": "read"
      }
    },
    {
      "id": "match_flow",
      "type": "branch",
      "name": "Stop if no flow is active for this event",
      "needs": [
        "find_flow"
      ],
      "branch": {
        "cases": [
          {
            "if": "steps.find_flow.output.flow == null",
            "goto": "end"
          }
        ],
        "else": "delay"
      }
    },
    {
      "id": "delay",
      "type": "wait",
      "name": "Flow delay (for example +1 h for a cart). Exits early on the exit event (purchase, opt-out)",
      "needs": [
        "match_flow"
      ],
      "wait": {
        "event": "{{ steps.find_flow.output.flow.exit_event }}",
        "match": "event.data.contact_id == input.contact_id",
        "timeout": "${steps.find_flow.output.flow.delay}"
      }
    },
    {
      "id": "contact",
      "type": "tool",
      "name": "Resolve the contact on every channel (push, whatsapp, sms, email) with consent and send_window",
      "needs": [
        "delay"
      ],
      "tool": {
        "name": "engine",
        "action": "audiences.resolve",
        "risk": "read"
      }
    },
    {
      "id": "plan_channel",
      "type": "tool",
      "name": "Channel waterfall, caps and send window (service code: messaging.chooseChannel, checkCaps, nextAllowed)",
      "needs": [
        "contact"
      ],
      "tool": {
        "name": "messaging",
        "action": "channel.plan",
        "risk": "read"
      }
    },
    {
      "id": "choose",
      "type": "branch",
      "name": "Stop on the exit event, on no channel or on a cap. Email goes to the email service",
      "needs": [
        "plan_channel"
      ],
      "branch": {
        "cases": [
          {
            "if": "!steps.delay.timed_out || steps.plan_channel.output.channel == 'none' || !steps.plan_channel.output.caps_allowed",
            "goto": "end"
          },
          {
            "if": "steps.plan_channel.output.channel == 'email'",
            "goto": "to_email"
          }
        ],
        "else": "hold"
      }
    },
    {
      "id": "hold",
      "type": "wait",
      "name": "Hold until messaging.nextAllowed() (send window, quiet day, holiday)",
      "needs": [
        "choose"
      ],
      "wait": {
        "event": "svc.messaging/flow.cancelled",
        "match": "event.data.contact_id == input.contact_id",
        "timeout": "${steps.plan_channel.output.hold}"
      }
    },
    {
      "id": "hold_done",
      "type": "branch",
      "name": "Stop if the flow was cancelled during the hold",
      "needs": [
        "hold"
      ],
      "branch": {
        "cases": [
          {
            "if": "!steps.hold.timed_out",
            "goto": "end"
          }
        ],
        "else": "compliance"
      }
    },
    {
      "id": "compliance",
      "type": "check",
      "name": "Engine compliance gate for this template, market and contact",
      "needs": [
        "hold_done"
      ],
      "check": {
        "kinds": [
          "compliance"
        ]
      }
    },
    {
      "id": "send",
      "type": "subflow",
      "name": "Send on the chosen channel",
      "needs": [
        "compliance"
      ],
      "subflow": {
        "workflow_id": "messaging.send"
      }
    },
    {
      "id": "fallback",
      "type": "branch",
      "name": "Utility WhatsApp message with SMS consent: watch the delivery for 10 minutes",
      "needs": [
        "send"
      ],
      "branch": {
        "cases": [
          {
            "if": "input.category == 'UTILITY' && steps.plan_channel.output.channel == 'whatsapp' && steps.plan_channel.output.sms_consent == 'granted'",
            "goto": "wait_delivery"
          }
        ],
        "else": "end"
      }
    },
    {
      "id": "wait_delivery",
      "type": "wait",
      "name": "Wait 10 minutes for the delivery receipt",
      "needs": [
        "fallback"
      ],
      "wait": {
        "event": "engine/outbound.recorded",
        "match": "event.data.contact_id == input.contact_id && event.data.type == 'delivered'",
        "timeout": "10m"
      }
    },
    {
      "id": "delivered",
      "type": "branch",
      "name": "Not delivered in 10 minutes: send the SMS version",
      "needs": [
        "wait_delivery"
      ],
      "branch": {
        "cases": [
          {
            "if": "steps.wait_delivery.timed_out",
            "goto": "send_sms_fallback"
          }
        ],
        "else": "end"
      }
    },
    {
      "id": "send_sms_fallback",
      "type": "subflow",
      "name": "SMS fallback for a utility message",
      "needs": [
        "delivered"
      ],
      "subflow": {
        "workflow_id": "messaging.send"
      }
    },
    {
      "id": "to_email",
      "type": "emit",
      "name": "Hand the message to the email service (service 1)",
      "needs": [
        "choose"
      ],
      "emit": {
        "event": "svc.messaging/email.handoff"
      }
    },
    {
      "id": "end",
      "type": "emit",
      "name": "Flow step finished",
      "emit": {
        "event": "svc.messaging/flow.step.completed"
      },
      "needs": [
        "send_sms_fallback",
        "to_email"
      ]
    }
  ]
}
