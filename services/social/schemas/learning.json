{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social/learning@1",
  "type": "object",
  "properties": {
    "learnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "pattern": "^([A-Z]{2}(-[A-Z]{2})?|unknown)$"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text",
          "market",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    },
    "proposed_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "answer",
          "locale"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    }
  },
  "required": [
    "learnings",
    "proposed_answers"
  ],
  "additionalProperties": false
}