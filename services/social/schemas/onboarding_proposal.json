{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social/onboarding_proposal@1",
  "type": "object",
  "properties": {
    "pillars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "funnel_stage": {
            "enum": [
              "reach",
              "engage",
              "convert"
            ]
          }
        },
        "required": [
          "name",
          "share",
          "description",
          "funnel_stage"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 5
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "linkedin",
              "instagram",
              "tiktok",
              "youtube",
              "facebook",
              "x",
              "snapchat",
              "pinterest",
              "threads",
              "whatsapp_channel",
              "xing"
            ]
          },
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "pattern": "^([A-Z]{2}(-[A-Z]{2})?|unknown)$"
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "posts_per_week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          }
        },
        "required": [
          "platform",
          "handle",
          "market",
          "locale",
          "posts_per_week"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "voice_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "linkedin",
              "instagram",
              "tiktok",
              "youtube",
              "facebook",
              "x",
              "snapchat",
              "pinterest",
              "threads",
              "whatsapp_channel",
              "xing"
            ]
          },
          "market": {
            "type": "string",
            "pattern": "^([A-Z]{2}(-[A-Z]{2})?|unknown)$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "platform",
          "market",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 10
    },
    "approved_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "answer",
          "locale"
        ],
        "additionalProperties": false
      }
    },
    "pause_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date_or_event": {
            "type": "string",
            "minLength": 1
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([A-Z]{2}(-[A-Z]{2})?|unknown)$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date_or_event",
          "markets",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "pillars",
    "accounts",
    "voice_samples",
    "approved_answers",
    "pause_list",
    "questions",
    "blockers"
  ],
  "additionalProperties": false
}