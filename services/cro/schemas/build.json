{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/build@1",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "page",
        "variant"
      ]
    },
    "html": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "text",
              "attr",
              "insert",
              "remove",
              "style"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "selector",
          "action",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "preview_notes": {
      "type": "string"
    },
    "template_reused": {
      "type": "boolean",
      "description": "True when the page uses an approved template with no layout change (lets G2a skip)."
    },
    "only_moves_or_removes_approved_elements": {
      "type": "boolean",
      "description": "True when a variant only moves or removes approved elements (lets G2a skip)."
    }
  },
  "required": [
    "kind",
    "html",
    "changes",
    "preview_notes",
    "template_reused",
    "only_moves_or_removes_approved_elements"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "page"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "html": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
