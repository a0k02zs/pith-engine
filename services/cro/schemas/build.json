{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/build@1",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "page",
        "variant"
      ]
    },
    "html": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "text",
              "attr",
              "insert",
              "remove",
              "style"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "selector",
          "action",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "preview_notes": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "html",
    "changes",
    "preview_notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "properties": {
          "html": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "changes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
