{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/qa_report@1",
  "type": "object",
  "properties": {
    "overall": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "overall",
    "items"
  ],
  "additionalProperties": false
}
