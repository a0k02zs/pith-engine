{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/funnel_audit@1",
  "type": "object",
  "properties": {
    "tracking_ok": {
      "type": "boolean"
    },
    "broken_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "first_seen": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "event",
          "reason",
          "first_seen"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "device": {
            "enum": [
              "mobile",
              "desktop",
              "tablet"
            ]
          },
          "step_cvr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "benchmark_cvr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lost_conversions_28d": {
            "type": "number",
            "minimum": 0
          },
          "cwv_fail": {
            "type": "array",
            "items": {
              "enum": [
                "LCP",
                "INP",
                "CLS"
              ]
            }
          }
        },
        "required": [
          "step",
          "market",
          "device",
          "step_cvr",
          "benchmark_cvr",
          "lost_conversions_28d",
          "cwv_fail"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    }
  },
  "required": [
    "tracking_ok",
    "broken_events",
    "problems"
  ],
  "additionalProperties": false
}
