{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/hypotheses@1",
  "type": "object",
  "properties": {
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "^Because we saw "
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
            },
            "minItems": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "primary_metric": {
            "type": "string",
            "minLength": 1
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "priority": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 25
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "NEW_CLAIM",
                "NEEDS_FINANCE_APPROVAL",
                "CHECKOUT_CHANGE"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "page",
          "markets",
          "audience",
          "primary_metric",
          "guardrails",
          "evidence_ids",
          "impact",
          "confidence",
          "effort",
          "priority",
          "flags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "hypotheses"
  ],
  "additionalProperties": false
}
