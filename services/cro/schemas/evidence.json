{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/evidence@1",
  "type": "object",
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "type": {
            "enum": [
              "analytics",
              "behaviour",
              "survey",
              "voice"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "step",
          "market",
          "type",
          "finding",
          "quote",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "theme",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "evidence",
    "themes"
  ],
  "additionalProperties": false
}
