{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cro/test_plan@1",
  "type": "object",
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "design": {
      "enum": [
        "ab",
        "abn",
        "not_testable"
      ]
    },
    "fallback": {
      "enum": [
        null,
        "bolder_change",
        "higher_funnel_metric",
        "fix_and_monitor"
      ]
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mde_relative": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    },
    "power": {
      "type": "number",
      "minimum": 0.8,
      "exclusiveMaximum": 1
    },
    "arms": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5
    },
    "sample_per_arm": {
      "type": "integer",
      "minimum": 1
    },
    "days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 14,
      "maximum": 42
    },
    "start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
      },
      "minItems": 1
    },
    "devices": {
      "type": "array",
      "items": {
        "enum": [
          "mobile",
          "desktop",
          "tablet"
        ]
      },
      "minItems": 1
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "stop_if": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "metric",
          "stop_if"
        ],
        "additionalProperties": false
      }
    },
    "method": {
      "enum": [
        "fixed_horizon",
        "sequential"
      ]
    },
    "reason_for_changes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "hypothesis_id",
    "design",
    "fallback",
    "primary_metric",
    "baseline",
    "mde_relative",
    "alpha",
    "power",
    "arms",
    "sample_per_arm",
    "days",
    "start",
    "end",
    "markets",
    "devices",
    "guardrails",
    "method",
    "reason_for_changes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "design": {
            "const": "not_testable"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "fallback": {
            "type": "string"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "fallback": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "design": {
            "const": "ab"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "arms": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "design": {
            "const": "abn"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "arms": {
            "type": "integer",
            "minimum": 3
          }
        }
      }
    }
  ]
}
