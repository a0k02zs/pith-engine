{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand/insights@1",
  "title": "brand insights output",
  "type": "object",
  "properties": {
    "insights": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "ref"
              ]
            }
          },
          "so_what": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "text",
          "evidence",
          "so_what",
          "confidence"
        ]
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3
    }
  },
  "required": [
    "insights",
    "tensions"
  ]
}
