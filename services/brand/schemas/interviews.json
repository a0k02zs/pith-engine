{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand/interviews@1",
  "title": "brand interviews output",
  "type": "object",
  "properties": {
    "interviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger": {
            "type": "string"
          },
          "objections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "choice_reason": {
            "type": "string"
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "segment"
        ]
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string"
          },
          "interview_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3
          },
          "strength": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "finding",
          "interview_ids"
        ]
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "interviews",
    "patterns"
  ]
}
