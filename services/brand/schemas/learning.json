{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand/learning@1",
  "title": "brand learning output",
  "type": "object",
  "properties": {
    "learnings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "insight": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "insight",
          "confidence",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "learnings"
  ]
}
