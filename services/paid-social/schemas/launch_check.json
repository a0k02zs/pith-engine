{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paid_social/launch_check@1",
  "type": "object",
  "properties": {
    "ready": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ready",
    "checks",
    "blockers"
  ],
  "additionalProperties": false
}
