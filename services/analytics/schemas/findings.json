{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics/findings@1",
  "type": "object",
  "properties": {
    "blocked": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "so_what": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "suggested_action": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "what",
          "so_what",
          "confidence",
          "evidence",
          "suggested_action"
        ],
        "additionalProperties": false
      },
      "maxItems": 5
    },
    "model_disagreement": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "spread": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "channel",
          "spread",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "platform_claim_ratio": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "blocked",
    "findings",
    "model_disagreement",
    "platform_claim_ratio"
  ],
  "additionalProperties": false
}
