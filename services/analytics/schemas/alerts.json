{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics/alerts@1",
  "type": "object",
  "properties": {
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "high",
              "medium"
            ]
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "kpi": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "number"
          },
          "expected": {
            "type": "number"
          },
          "band": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "days": {
            "type": "integer",
            "minimum": 1
          },
          "likely_cause": {
            "type": "string",
            "minLength": 1
          },
          "check_next": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "enum": [
              "performance_marketer",
              "analytics_lead",
              "strategist"
            ]
          }
        },
        "required": [
          "severity",
          "client_id",
          "market",
          "channel",
          "kpi",
          "observed",
          "expected",
          "band",
          "days",
          "likely_cause",
          "check_next",
          "owner_role"
        ],
        "additionalProperties": false
      }
    },
    "explained": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kpi": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kpi",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "alerts",
    "explained"
  ],
  "additionalProperties": false
}
