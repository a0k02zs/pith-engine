{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics/decision_log@1",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "decision",
          "owner",
          "due"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false
}
