{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search/schema_markup@1",
  "type": "object",
  "properties": {
    "jsonld": {
      "type": "object",
      "properties": {
        "@context": {
          "const": "https://schema.org"
        },
        "@type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "required": [
        "@context",
        "@type"
      ]
    },
    "llms_txt": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "jsonld",
    "llms_txt",
    "warnings"
  ],
  "additionalProperties": false
}
