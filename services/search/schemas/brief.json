{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search/brief@1",
  "type": "object",
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^se-[0-9]{4}-[0-9]{2}-[0-9]{3}$"
    },
    "cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "page_type": {
      "enum": [
        "solution",
        "comparison",
        "glossary",
        "use_case",
        "research",
        "category",
        "product",
        "buying_guide",
        "faq_hub",
        "how_to"
      ]
    },
    "target_query": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": [
        "informational",
        "commercial",
        "transactional",
        "navigational"
      ]
    },
    "main_question": {
      "type": "string",
      "pattern": "\\?$"
    },
    "direct_answer": {
      "type": "string",
      "minLength": 1
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "h2": {
            "type": "string",
            "minLength": 1
          },
          "h3": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "h2",
          "h3"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "source_url"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "new_claim": {
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "new_claim"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "gap_angle": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "expert_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5
    },
    "internal_links_out": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "internal_links_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "schema_type": {
      "type": "string",
      "minLength": 1
    },
    "title_tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "meta_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 155
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "word_range": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "brief_id",
    "cluster_id",
    "market",
    "locale",
    "page_type",
    "target_query",
    "intent",
    "main_question",
    "direct_answer",
    "outline",
    "facts",
    "claims",
    "gap_angle",
    "entities",
    "expert_questions",
    "internal_links_out",
    "internal_links_in",
    "schema_type",
    "title_tag",
    "meta_description",
    "slug",
    "word_range"
  ],
  "additionalProperties": false
}
