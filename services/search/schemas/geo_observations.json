{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search/geo_observations@1",
  "type": "object",
  "properties": {
    "prompt_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "enum": [
        "chatgpt",
        "perplexity",
        "gemini",
        "ai_overviews",
        "ai_mode",
        "copilot",
        "claude"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run": {
            "type": "integer",
            "minimum": 1
          },
          "client_mentioned": {
            "type": "boolean"
          },
          "client_cited": {
            "type": "boolean"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sentiment": {
            "enum": [
              "positive",
              "neutral",
              "negative"
            ]
          },
          "competitors_mentioned": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "cited_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "wrong_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "correct": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "claim",
                "correct"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "run",
          "client_mentioned",
          "client_cited",
          "position",
          "sentiment",
          "competitors_mentioned",
          "cited_domains",
          "wrong_facts"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "source_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "domain",
          "why"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "prompt_id",
    "engine",
    "runs",
    "source_gaps"
  ],
  "additionalProperties": false
}
