{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search/prompt_set@1",
  "type": "object",
  "properties": {
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "category",
              "problem",
              "comparison",
              "brand"
            ]
          },
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              1,
              2,
              3
            ]
          }
        },
        "required": [
          "id",
          "text",
          "type",
          "cluster_id",
          "priority"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "market",
    "locale",
    "prompts"
  ],
  "additionalProperties": false
}
