{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search/sem_build@1",
  "type": "object",
  "properties": {
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "search",
              "pmax",
              "shopping"
            ]
          },
          "split": {
            "enum": [
              "brand",
              "non_brand",
              "competitor"
            ]
          },
          "daily_budget": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bid_strategy": {
            "enum": [
              "manual_cpc",
              "max_conversions",
              "target_cpa",
              "target_roas",
              "max_clicks"
            ]
          },
          "ad_category": {
            "type": "string"
          },
          "ad_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "cluster_id": {
                  "type": "string"
                },
                "final_url": {
                  "type": "string",
                  "minLength": 1
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "match": {
                        "enum": [
                          "exact",
                          "phrase",
                          "broad"
                        ]
                      }
                    },
                    "required": [
                      "text",
                      "match"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "ads": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "headlines": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 30
                        },
                        "minItems": 15
                      },
                      "descriptions": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 90
                        },
                        "minItems": 4
                      },
                      "final_url": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "headlines",
                      "descriptions",
                      "final_url"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "name",
                "cluster_id",
                "final_url",
                "keywords",
                "ads"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "type",
          "split",
          "daily_budget",
          "bid_strategy",
          "ad_category",
          "ad_groups"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "negatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "account",
              "campaign",
              "ad_group"
            ]
          },
          "target": {
            "type": "string"
          },
          "keyword": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "enum": [
              "exact",
              "phrase",
              "broad"
            ]
          }
        },
        "required": [
          "level",
          "target",
          "keyword",
          "match"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "assets": {
      "type": "object",
      "properties": {
        "sitelinks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 25
          },
          "minItems": 4
        },
        "structured_snippet": {
          "type": "object",
          "properties": {
            "header": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 3
            }
          },
          "required": [
            "header",
            "values"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sitelinks",
        "callouts",
        "structured_snippet"
      ],
      "additionalProperties": false
    },
    "new_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "proposed_source": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "proposed_source"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "market",
    "locale",
    "currency",
    "campaigns",
    "negatives",
    "assets",
    "new_claims"
  ],
  "additionalProperties": false
}
