{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/run_of_show@1",
  "type": "object",
  "properties": {
    "run_of_show": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "start_min": {
            "type": "integer",
            "minimum": 0
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "slide_titles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 5
          },
          "key_point": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "block",
          "speaker",
          "start_min",
          "minutes",
          "slide_titles",
          "key_point"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "polls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 6
          },
          "purpose": {
            "enum": [
              "engagement",
              "qualification"
            ]
          }
        },
        "required": [
          "question",
          "options",
          "purpose"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "prepared_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string"
          },
          "needs_live_speaker": {
            "type": "boolean"
          }
        },
        "required": [
          "question",
          "answer",
          "needs_live_speaker"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 12
    },
    "speaker_brief": {
      "type": "string",
      "minLength": 1
    },
    "recording_notice": {
      "type": "string",
      "minLength": 1
    },
    "new_claim_requests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run_of_show",
    "polls",
    "prepared_answers",
    "speaker_brief",
    "recording_notice",
    "new_claim_requests",
    "blockers"
  ],
  "additionalProperties": false
}
