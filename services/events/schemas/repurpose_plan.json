{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/repurpose_plan@1",
  "type": "object",
  "properties": {
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "minLength": 1
          },
          "end": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "needs_speaker_ok": {
            "type": "boolean"
          }
        },
        "required": [
          "start",
          "end",
          "hook",
          "speaker",
          "needs_speaker_ok"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 5
    },
    "blog_outline": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "needs_speaker_ok": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "timestamp",
              "needs_speaker_ok"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "points",
        "quotes"
      ],
      "additionalProperties": false
    },
    "email_series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "angle": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "subject",
          "angle"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "social_posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "platform",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    },
    "one_pager_outline": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 5
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "enum": [
              "video",
              "content",
              "email",
              "social"
            ]
          }
        },
        "required": [
          "asset",
          "service"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "clips",
    "blog_outline",
    "email_series",
    "social_posts",
    "one_pager_outline",
    "assignments"
  ],
  "additionalProperties": false
}
