{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/pacing@1",
  "type": "object",
  "properties": {
    "by_market": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "target_to_date": {
            "type": "integer",
            "minimum": 0
          },
          "actual_to_date": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "on_track",
              "at_risk",
              "off_track"
            ]
          }
        },
        "required": [
          "market",
          "target_to_date",
          "actual_to_date",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "action": {
            "enum": [
              "email_new_segment",
              "sales_personal_invites",
              "partner_copromotion",
              "social_post",
              "paid_boost",
              "second_session"
            ]
          },
          "expected_registrations": {
            "type": "integer",
            "minimum": 0
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "needs_budget_gate": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "market",
          "action",
          "expected_registrations",
          "cost",
          "needs_budget_gate",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 3
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "by_market",
    "actions",
    "blockers"
  ],
  "additionalProperties": false
}
