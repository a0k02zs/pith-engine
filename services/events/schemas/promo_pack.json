{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/promo_pack@1",
  "type": "object",
  "properties": {
    "promo_brief": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "headlines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "minItems": 3,
          "maxItems": 3
        },
        "speaker_lines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_times": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "market": {
                "type": "string",
                "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
              },
              "local_datetime": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "market",
              "local_datetime",
              "timezone"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "channel_messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "channel",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "audience",
        "problem",
        "outcomes",
        "headlines",
        "speaker_lines",
        "session_times",
        "channel_messages"
      ],
      "additionalProperties": false
    },
    "registration_page": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "speaker_bios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "form_intro": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "headline",
        "bullets",
        "speaker_bios",
        "form_intro"
      ],
      "additionalProperties": false
    },
    "confirmation_email": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subject",
        "body"
      ],
      "additionalProperties": false
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offset": {
            "enum": [
              "T-7d",
              "T-1d",
              "T-1h",
              "T-10min"
            ]
          },
          "channel": {
            "enum": [
              "email",
              "sms",
              "whatsapp"
            ]
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "offset",
          "channel",
          "subject",
          "body"
        ],
        "additionalProperties": false
      },
      "minItems": 4
    },
    "follow_up_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment": {
            "enum": [
              "hot",
              "engaged",
              "no_show",
              "on_demand"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "segment",
          "subject",
          "body"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4
    },
    "new_claim_requests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "promo_brief",
    "registration_page",
    "confirmation_email",
    "reminders",
    "follow_up_templates",
    "new_claim_requests",
    "blockers"
  ],
  "additionalProperties": false
}
