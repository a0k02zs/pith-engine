{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/signals@1",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "string",
            "minLength": 1
          },
          "hand_raise": {
            "type": "boolean"
          },
          "asked_question": {
            "type": "boolean"
          },
          "top_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 2
          }
        },
        "required": [
          "contact_id",
          "hand_raise",
          "asked_question",
          "top_signals"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "records"
  ],
  "additionalProperties": false
}
